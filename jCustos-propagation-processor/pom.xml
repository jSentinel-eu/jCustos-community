<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-propagation-processor</artifactId>
  <name>jCustos Propagation Processor</name>
  <description>
    Compile-time annotation processor that generates a Propagating
    wrapper for each @PropagateToken-annotated concrete class /
    interface. The generated wrapper binds the
    PropagateTokenAdvisor-resolved HeaderValue into
    OutboundHeaderContext around every annotated method.

    Runtime sibling: PropagatingProxy.wrap(...) in jCustos-propagation
    for the JDK Dynamic Proxy path on interfaces.
  </description>

  <properties>
    <proxybuilder.version>00.11.00</proxybuilder.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>proxybuilder</artifactId>
      <version>${proxybuilder.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>proxybuilder-annotations</artifactId>
      <version>${proxybuilder.version}</version>
    </dependency>

    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
