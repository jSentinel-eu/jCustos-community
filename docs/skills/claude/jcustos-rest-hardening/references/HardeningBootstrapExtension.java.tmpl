package {{BASE_PACKAGE}}.security.bootstrap;

import eu.jsentinel.jcustos.authorization.api.JCustosServiceResolver;
import eu.jsentinel.jcustos.authorization.api.SubjectIdResolver;
import eu.jsentinel.jcustos.bootstrap.PasswordPolicy;
import eu.jsentinel.jcustos.credential.password.bouncycastle.BouncyCastleHashingServices;
import {{BASE_PACKAGE}}.security.services.PasswordPreflight;
import eu.jsentinel.jcustos.dx.bootstrap.CredentialBootstrap;
import eu.jsentinel.jcustos.dx.bootstrap.SessionBootstrap;
import eu.jsentinel.jcustos.session.JCustosVersionStore;

import java.util.Optional;

/**
 * Hardening-layer extension. Contributes Argon2id hashing,
 * Phase-4c drift-detection wiring and the password preflight for the
 * first administrator to the layer-1 bootstrap chain.
 *
 * <p>The Argon2id pipeline set with {@code .hashing(...)} is the one
 * the user directory and the first-admin bootstrap hash with — they
 * read {@code JCustosServiceResolver.credentialHashingService()}
 * (JS-SEC-134). Hashes written before the switch verify and are
 * replaced on the next successful login.
 *
 * <p>{@link #order()} returns 20 so this runs after persistence's
 * {@code storeBacked(...)} session-store wire stays in effect while
 * hardening adds the version-store binding on top.
 */
public final class HardeningBootstrapExtension implements BootstrapExtension {

  @Override
  public void contributeCredentials(CredentialBootstrap c) {
    c.hashing(BouncyCastleHashingServices.modern());
  }

  @Override
  public void contributeSessions(SessionBootstrap s) {
    Optional<JCustosVersionStore> versionStore =
        JCustosServiceResolver.findJCustosVersionStore();
    Optional<SubjectIdResolver<Object>> resolver =
        JCustosServiceResolver.findSubjectIdResolver();
    versionStore.ifPresent(s::securityVersion);
    resolver.ifPresent(s::subjectIdResolver);
  }

  /**
   * The first administrator's password passes {@link PasswordPreflight}
   * too (JS-SEC-134): the most privileged account is not the one exempt
   * from the blocklist and the breach check.
   */
  @Override
  public PasswordPolicy initialAdminPasswordPolicy(PasswordPolicy base) {
    return PasswordPreflight.policy(base);
  }

  @Override
  public int order() {
    return 20;
  }
}
