package {{BASE_PACKAGE}}.security.services;

import eu.jsentinel.jcustos.bootstrap.PasswordPolicy;
import eu.jsentinel.jcustos.credential.compromised.CompromisedPasswordChecker;
import eu.jsentinel.jcustos.credential.compromised.CompromisedPasswordResult;
import eu.jsentinel.jcustos.credential.compromised.LocalBlocklistCompromisedPasswordChecker;
import eu.jsentinel.jcustos.credential.secret.SecretValue;

import java.time.Duration;
import java.util.List;
import java.util.Objects;
import java.util.OptionalInt;

/**
 * Password-acceptance check called before any new / changed password
 * is committed.
 *
 * <p>Two layers:
 *
 * <ol>
 *   <li>A local blocklist for the top-N most-common passwords —
 *       fast, offline, always on.</li>
 *   <li>(if {{HIBP_ENABLED}}=true) an online k-anonymity range
 *       query against the HaveIBeenPwned API — the plain candidate
 *       never leaves the JVM, only the first 5 SHA-1 hex chars.</li>
 * </ol>
 *
 * <p>Both layers return {@link CompromisedPasswordResult} variants.
 * The caller treats {@link CompromisedPasswordResult.Pwned} as
 * reject (generic message, never name the dictionary — CWE-209) and
 * everything else as accept.
 *
 * <p>Network failures on the HIBP path return
 * {@link CompromisedPasswordResult.Indeterminate} — fail-open by
 * design (CWE-359): a corporate firewall blocking the HIBP API
 * should not block legitimate password changes.
 */
public final class PasswordPreflight {

  private static final CompromisedPasswordChecker LOCAL =
      new LocalBlocklistCompromisedPasswordChecker(List.of(
          "password", "password1", "password123",
          "qwerty", "qwerty123", "letmein",
          "admin", "admin123", "administrator",
          "welcome", "welcome1",
          "12345678", "123456789", "abc12345",
          "iloveyou", "monkey", "dragon",
          "hunter2", "trustno1"));

  private static volatile CompromisedPasswordChecker online = defaultOnlineChecker();

  /** Generic reason shown for a rejected password; never names the list (CWE-209). */
  public static final String REJECTION_REASON = "password rejected: on a known-bad list";

  private PasswordPreflight() {
  }

  /**
   * Returns {@code true} if the candidate is acceptable. {@code false}
   * means a Pwned result from one of the layers — caller shows a
   * generic rejection message.
   */
  public static boolean isAcceptable(String candidate) {
    if (candidate == null || candidate.isEmpty()) {
      return false;
    }
    return isAcceptable(SecretValue.ofString(candidate));
  }

  /**
   * The preflight as a {@link PasswordPolicy} on top of {@code base}: a
   * password has to pass {@code base} and the preflight. The first-admin
   * bootstrap uses it, so the most privileged account is held to the same
   * standard as every user created later (JS-SEC-134).
   */
  public static PasswordPolicy policy(PasswordPolicy base) {
    Objects.requireNonNull(base, "base");
    return new PasswordPolicy() {
      @Override
      public PasswordPolicyResult validate(char[] password) {
        PasswordPolicyResult first = base.validate(password);
        if (!first.valid()) {
          return first;
        }
        if (password == null || password.length == 0
            || !isAcceptable(SecretValue.ofChars(password))) {
          return PasswordPolicyResult.violation(REJECTION_REASON);
        }
        return PasswordPolicyResult.ok();
      }

      @Override
      public OptionalInt minLength() {
        return base.minLength();
      }
    };
  }

  /**
   * Test seam — replaces the online checker ({@code null} restores the
   * default), so tests do not call the HaveIBeenPwned API.
   */
  public static void useOnlineChecker(CompromisedPasswordChecker replacement) {
    online = replacement == null ? defaultOnlineChecker() : replacement;
  }

  private static boolean isAcceptable(SecretValue secret) {
    if (LOCAL.check(secret) instanceof CompromisedPasswordResult.Pwned) {
      return false;
    }
    CompromisedPasswordChecker hibp = online;
    return hibp == null || !(hibp.check(secret) instanceof CompromisedPasswordResult.Pwned);
  }

  // {{HIBP_ENABLED}}=true → return the HIBP checker; false → return null (online check skipped)
  private static CompromisedPasswordChecker defaultOnlineChecker() {
    return eu.jsentinel.jcustos.credential.compromised.hibp.HaveIBeenPwnedCompromisedPasswordChecker
        .usingJdkHttpClient(
            eu.jsentinel.jcustos.credential.compromised.hibp.HaveIBeenPwnedCompromisedPasswordChecker.DEFAULT_ENDPOINT,
            Duration.ofSeconds(5));
  }
}
