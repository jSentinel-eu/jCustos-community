<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>demo-rest-shared</artifactId>
  <name>jCustos - REST Demo shared</name>
  <description>
    Transport-level constants and helpers shared between the demo-rest
    server and any client (CLI, Vaadin REST client). Demo-only.
  </description>

  <properties>
    <!--
      Library-style demo module: do NOT push to a remote repository, but
      DO install into the local ~/.m2 so demo-rest and
      demo-vaadin-rest-client can resolve it outside of a reactor build.
    -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        deploy is suppressed via the maven.deploy.skip property above —
        no separate plugin block needed. install runs normally so the
        artifact lands in ~/.m2 for non-reactor consumers.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>