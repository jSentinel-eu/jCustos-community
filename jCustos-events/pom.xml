<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-events</artifactId>
  <name>jCustos Events — Security Event Bus core</name>
  <description>
    V00.75 SPI core for the Security Event Bus: sealed SecurityEvent
    hierarchy, signed SecurityEventEnvelope, EventBus API,
    Publish/Consume pipelines, and the SPI surfaces for
    SignatureAlgorithm, PayloadCodec, KeyManagement, ReplayStore,
    SequenceStore, ProducerPolicy, EventStore, DeadLetterStore.
    Framework-neutral — no Vaadin, no REST framework, no Eclipse Store.
    Persistent stores and the REST/SSE bridge ship in the jCustos
    Enterprise edition.
  </description>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- V00.80.00: typed fallible returns (Result) for the wire codec. -->
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>functional-reactive</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        V00.75 §71 / §6.3: the canonical-JSON codec is in-tree. Ban Jackson /
        Gson / org.json on the compile/runtime classpath so no transitive
        JSON library can silently take over the wire format. Test scope is
        allowed for independent cross-validation.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-json-libraries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.fasterxml.jackson.core:*</exclude>
                    <exclude>com.fasterxml.jackson.databind:*</exclude>
                    <exclude>com.google.code.gson:*</exclude>
                    <exclude>org.json:json</exclude>
                  </excludes>
                  <includes>
                    <include>com.fasterxml.jackson.core:*:*:*:test</include>
                    <include>com.fasterxml.jackson.databind:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
