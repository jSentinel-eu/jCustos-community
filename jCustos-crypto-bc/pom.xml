<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.10-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-crypto-bc</artifactId>
  <name>jCustos Crypto — BouncyCastle</name>
  <description>
    Optional Phase-1b extension that adds memory-hard and bcrypt-style
    password hashing providers backed by BouncyCastle (Argon2id,
    bcrypt, scrypt) on top of the V00.71 PasswordHashProvider SPI from
    jCustos-core. Strictly opt-in: applications that do not depend on
    this module never pull in bcprov. Loading the module also does not
    touch the global JCA provider order — every algorithm is invoked
    through the BouncyCastle low-level Bouncy Castle Crypto APIs.
  </description>

  <properties>
    <!--
      Pinned at 1.86. Advisory history of the pin:
        * 1.84 closed GHSA-p93r-85wp-75v3 / CVE-2026-5598 (covert timing
          channel in FrodoEngine, affected [1.71, 1.84)) and
          GHSA-c3fc-8qff-9hwx / CVE-2026-0636 (LDAP injection in
          LDAPStoreHelper, affected [1.74, 1.84)).
        * 1.85 closed GHSA-9pwp-9qqc-pr26 / CVE-2026-8763 (name
          constraints bypassed by a trailing dot) and
          GHSA-qp49-qgx5-5m26 / CVE-2026-13506 (ASN.1 nesting guard is
          reset). 1.86 is the current release of the same line.
      None of these code paths is exercised by jCustos-crypto-bc (it
      only uses the Argon2id / bcrypt / scrypt low-level primitives),
      but the jar sits on the consumer's class path, where the
      application may well use X.509 or ASN.1 parsing. Do not go below
      1.85.
    -->
    <bouncycastle.version>1.86</bouncycastle.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>