<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-core</artifactId>
  <name>jCustos Core</name>
  <description>Core authentication, authorization, and annotation-driven access contracts without Vaadin dependencies.</description>

  <dependencies>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <!-- V00.76: typed fallible returns (Result) for the jwt/api JwtValidator SPI. -->
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>functional-reactive</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Skip the inherited license-maven-plugin: EUPL 1.2 headers are
           maintained directly in the source files (JavaDoc comment style).
           The plugin's #%L blocks are redundant and cause checkstyle
           trailing-space violations. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>


</project>