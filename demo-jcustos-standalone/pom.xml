<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>demo-jcustos-standalone</artifactId>
  <name>jCustos - Skill Demo: standalone</name>
  <description>Reference output of the jcustos-standalone skill — minimal CLI with admin/admin + user/user, SecuredProxy.wrap(...) enforcement.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <gpg.skip>true</gpg.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.svenruppert</groupId>
      <artifactId>core</artifactId>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-autoservice-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-standalone</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-dx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-dx-standalone</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>eu.jsentinel</groupId>
              <artifactId>jCustos-autoservice-processor</artifactId>
              <version>${project.version}</version>
            </path>
            <path>
              <groupId>eu.jsentinel</groupId>
              <artifactId>jCustos-autoservice-annotations</artifactId>
              <version>${project.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
