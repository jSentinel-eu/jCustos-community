<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-events-testkit</artifactId>
  <name>jCustos Events — Contract testkit</name>
  <description>
    V00.75 contract test suites (JUnit-5 @Test default interfaces) for
    the seven Security Event Bus SPIs: PayloadCodec, SignatureAlgorithm,
    KeyManagement, ReplayStore, SequenceStore, ProducerPolicy,
    EventStore. Persistence-tech-agnostic — every adapter
    implementation hands a fresh SPI instance into a newStore() method
    and inherits the full contract.
  </description>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-events</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Contract suites use @Test default methods, so the API is compile-scoped. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
