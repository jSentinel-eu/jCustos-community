<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-vaadin-starter</artifactId>
  <name>jCustos Vaadin Starter</name>
  <description>
    V00.72 declarative UI security layer over the Vaadin Secured*
    components: SecuredUi.button / link / menuItem, @SecureRoute, and
    starter profiles (development / production / strict).
  </description>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-vaadin</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-dx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-dx-vaadin</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-autoservice-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- JS-SEC-067: JCustosErrorHandler sets the error handler of a VaadinSession, whose
         type references jakarta.servlet types; provided by the servlet container. -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- JS-SEC-168: VaadinJCustosStarter.serviceInit loads the OIDC session-registry cleanup
         by name; the test shows that it is registered when the module is on the class path.
         The starter itself does not depend on the OIDC modules. -->
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-identity-oidc-vaadin</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JS-SEC-067: JCustosErrorHandler is tested through real Vaadin sessions, the
         router and the RPC handler (browserless). -->
    <dependency>
      <groupId>com.vaadin</groupId>
      <artifactId>browserless-test-junit6</artifactId>
      <version>1.0.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>