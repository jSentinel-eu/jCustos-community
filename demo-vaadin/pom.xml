<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-community-parent</artifactId>
        <version>00.84.00-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>demo-vaadin</artifactId>
    <packaging>war</packaging>
    <name>jCustos - Vaadin Demo</name>
    <description>Demo application for Vaadin view security, roles, permissions, and UI integration.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <gpg.skip>true</gpg.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-autoservice-annotations</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-vaadin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            V00.72 fluent bootstrap. BootstrapServiceInitListener now calls
            VaadinSecurity.bootstrap() with .use(developmentDefaults()) at
            Vaadin service init and prints the JCustosRuntime.log() banner.
        -->
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-dx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-dx-vaadin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-vaadin-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
          Servlet API at compile time only (provided by the Jetty/servlet
          container at runtime). Needed because com.vaadin.flow.server.VaadinSession
          implements jakarta.servlet.http.HttpSessionBindingListener, so javac must
          resolve that interface wherever VaadinSession is referenced (e.g.
          MyLoginView.recordSession) even though the binding callbacks are never
          called here. Mirrors demo-vaadin-rest-client.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Annotations module shipped by jCustos-processor's underlying
          proxybuilder. The processor emits @GeneratedByProxyBuilder and
          @DelegatesTo into every generated wrapper class; consumers of
          the processor need the annotation types on their compile
          classpath even though RetentionPolicy.RUNTIME makes them stay
          around at runtime too.
        -->
        <dependency>
            <groupId>com.svenruppert</groupId>
            <artifactId>proxybuilder-annotations</artifactId>
            <version>00.11.00</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>eu.jsentinel</groupId>
            <artifactId>jCustos-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-junit6</artifactId>
            <version>1.0.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ROOT</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      Wire jCustos-processor as a compile-time annotation
                      processor. The processor expands @Secured-annotated
                      classes into a <Type>Secured subclass that routes
                      every guarded method through JCustosEnforcer before
                      the super-call.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>eu.jsentinel</groupId>
                            <artifactId>jCustos-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>eu.jsentinel</groupId>
                            <artifactId>jCustos-autoservice-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                        <path>
                            <groupId>eu.jsentinel</groupId>
                            <artifactId>jCustos-autoservice-annotations</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- Skip the inherited license-maven-plugin: EUPL 1.2 headers are
                 maintained directly in the source files. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>first</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.eclipse.jetty.ee11</groupId>
                <artifactId>jetty-ee11-maven-plugin</artifactId>
                <version>${jetty.version}</version>
                <configuration>
                    <scan>2</scan>
                    <webApp>
                        <allowDuplicateFragmentNames>true</allowDuplicateFragmentNames>
                    </webApp>
                </configuration>
                <!--
                    Force SLF4J 2.x onto the plugin's classloader. Jetty 12.1 internals
                    call Logger.atDebug() (only exists in SLF4J 2.0+), but transitive
                    Maven plugin deps still drag in slf4j-api 1.7.36, which otherwise
                    wins at @Push teardown with a NoSuchMethodError.
                -->
                <dependencies>
                    <dependency>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-api</artifactId>
                        <version>${slf4j-api.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-simple</artifactId>
                        <version>${slf4j-api.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <!--
                Take care of synchronizing java dependencies and imports in
                package.json and main.js files.
                It also creates webpack.config.js if not exists yet.
            -->
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-frontend</goal>
                            <goal>build-frontend</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>