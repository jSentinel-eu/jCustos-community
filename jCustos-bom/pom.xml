<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    This POM deliberately has NO <parent>.

    A BOM hands its complete effective dependency management to whoever
    imports it. As a child of jCustos-community-parent it therefore exported
    not only the jCustos modules, but also the Vaadin BOM and every
    third-party pin (with its scope) of com.svenruppert:dependencies, and
    silently moved libraries in the consumer's application to those versions.
    A stand-alone POM exports exactly the entries listed below and nothing
    else.

    Consequences of standing alone:
      * The version is a literal here and has to be raised together with the
        reactor version, in every version bump. Nothing in the build compares
        the two (Maven 4 warns against importing a BOM from within its own
        reactor, so no module does); the entries below follow this POM's own
        version.
      * Nothing is inherited. The metadata Maven Central asks for, the deploy
        target, the plugin versions and the signing profile are repeated
        below; keep them in step with the community parent.
      * Only eu.jsentinel entries belong into <dependencyManagement>, and
        neither properties nor imports that would leak into consumers.
      * scripts/gate.sh (stage bom) compares this POM with the reactor:
        same version, same project.build.outputTimestamp, and exactly the
        publishable modules of the root POM under <dependencyManagement>.
  -->
  <groupId>eu.jsentinel</groupId>
  <artifactId>jCustos-bom</artifactId>
  <version>00.84.00</version>
  <packaging>pom</packaging>

  <name>jCustos BOM</name>
  <description>
    Bill of materials for the jCustos community edition. Import it to pin every
    community artifact from one place instead of repeating versions per
    dependency. Covers the 37 library and testkit modules; demo modules are
    deliberately absent. It manages jCustos artifacts only and leaves every
    third-party version to the importing project.
  </description>
  <url>https://github.com/jSentinel-eu/jCustos-community</url>
  <inceptionYear>2018</inceptionYear>
  <organization>
    <name>jCustos by Sven Ruppert</name>
    <url>https://jsentinel.eu</url>
  </organization>
  <licenses>
    <license>
      <name>European Union Public Licence 1.2</name>
      <url>https://joinup.ec.europa.eu/software/page/eupl</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Sven Ruppert</name>
      <email>sven.ruppert@gmail.com</email>
      <roles>
        <role>Developer</role>
      </roles>
      <timezone>+1</timezone>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/jSentinel-eu/jCustos-community</url>
    <connection>scm:git:https://github.com/jSentinel-eu/jCustos-community.git</connection>
    <developerConnection>scm:git:https://github.com/jSentinel-eu/jCustos-community.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>Github</system>
    <url>https://github.com/jSentinel-eu/jCustos-community/issues</url>
  </issueManagement>

  <!-- The one property of this POM. Properties of an imported BOM do not reach
       the importing project, so nothing leaks. Same value as in the community
       parent (reproducible builds, SA42); change both together. -->
  <properties>
    <project.build.outputTimestamp>2026-11-11T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <!-- Same deploy target as the community parent; the repository ids are the
       ones the credentials are stored under and must not be renamed. -->
  <distributionManagement>
    <repository>
      <id>jsentinel-releases</id>
      <url>https://repo.jsentinel.eu/releases</url>
    </repository>
    <snapshotRepository>
      <id>jsentinel-snapshots</id>
      <url>https://repo.jsentinel.eu/snapshots</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-vaadin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-standalone</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-test</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-persistence-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-persistence-eclipsestore</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-crypto-bc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-credentials-hibp</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-autoservice-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-autoservice-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-dx</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-dx-vaadin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-dx-rest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-dx-standalone</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-vaadin-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-propagation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
        <artifactId>jCustos-propagation-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>eu.jsentinel</groupId>
