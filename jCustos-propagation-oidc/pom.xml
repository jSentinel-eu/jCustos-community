<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>eu.jsentinel</groupId>
    <artifactId>jCustos-community-parent</artifactId>
    <version>00.84.00-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>jCustos-propagation-oidc</artifactId>
  <name>jCustos Propagation OIDC (opt-in)</name>
  <description>
    Optional OIDC outbound-strategy module. Implements RFC 8693
    Token Exchange and RFC 6749 §4.4 Client Credentials over the JDK
    HttpClient. No JOSE library on compile or runtime — the response
    token is treated as opaque and validated by the next inbound
    resolver.
  </description>

  <dependencies>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-propagation</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>eu.jsentinel</groupId>
      <artifactId>jCustos-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-jose-libraries</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.nimbusds:nimbus-jose-jwt</exclude>
                    <exclude>io.jsonwebtoken:jjwt-api</exclude>
                    <exclude>io.jsonwebtoken:jjwt-impl</exclude>
                    <exclude>io.jsonwebtoken:jjwt-jackson</exclude>
                    <exclude>org.bitbucket.b_c:jose4j</exclude>
                  </excludes>
                  <message>
                    V00.74 jCustos-propagation-oidc must NOT ship a JOSE
                    library. The response token is treated as opaque; JOSE
                    validation belongs to the next inbound resolver.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>first</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
